datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LearningEntry {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  category      String
  content       String
  imageUrls     String[]
  descriptions  String[]
  datePublished String
  createdAt     DateTime @default(now())
}
